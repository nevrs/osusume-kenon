{
  "manifest_version": 3,
  "name": "おすすめ検温",
  "version": "0.6.0",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "description": "X のおすすめが炎上と対立に点数を付ける仕組みから、あなたを守る",
  "permissions": ["storage", "unlimitedStorage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["x-dom.js", "record-core.js", "record.js", "feed-judge.js"],
      "run_at": "document_idle"
    }
  ]
}

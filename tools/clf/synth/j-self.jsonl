{"id":"j001","intense":1,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"寝坊して大事な打ち合わせに遅刻した！！！もう消えたい！！！"}
{"id":"j002","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"人前で盛大に転んだ。しばらく消えていたい"}
{"id":"j003","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"昨日の飲み会の自分、思い出すだけで消えたくなる"}
{"id":"j004","intense":1,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"恥ずかしすぎて地球から消えたい！！！！"}
{"id":"j005","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"また同じミスをした。自分なんかいなくなればいいのにと思ってしまう"}
{"id":"j006","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"誰にも会いたくない。しばらくどこかへ消えたい"}
{"id":"j007","intense":1,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"もうやだ消えたい消えたい消えたい"}
{"id":"j008","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"穴があったら入りたい。いや、もういっそ消えたい"}
{"id":"j009","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"plain","pair":"","text":"保存し忘れて、半日分のデータが消えた"}
{"id":"j010","intense":1,"thorn":0,"grave":0,"amb":0,"kind":"hot-sad","pair":"","text":"データ全部消えた！！！！三日分の作業が！！！！"}
{"id":"j011","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"plain","pair":"","text":"朝の霧が、昼にはすっかり消えていた"}
{"id":"j012","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"plain","pair":"","text":"駅前の古い本屋が、今月で消えるらしい。寂しい"}
{"id":"j013","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"自分の昔の投稿、全部消したい。黒歴史すぎる"}
{"id":"j014","intense":1,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"緊張で声が裏返った！！！消えてなくなりたい！！！"}
{"id":"j015","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"plain","pair":"","text":"「消えたい」と書いていた友人に、そっと連絡した"}
{"id":"j016","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"ゲームで味方の足を引っ張ってばかり。自分が消えたほうがチームのためかも"}
{"id":"j017","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"今日の私、存在ごと消してほしい"}
{"id":"j018","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"plain","pair":"","text":"幕が下りて、舞台の明かりがふっと消えた"}
{"id":"j019","intense":1,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"財布落とした！！！傘も忘れた！！！今日の自分ほんと消えろ！！！"}
{"id":"j020","intense":0,"thorn":0,"grave":0,"amb":0,"kind":"self","pair":"","text":"失言したのは自分。しばらく黙って消えておきます"}
